# Sao chép thành .env (KHÔNG commit .env). Trên Render đặt các biến này trong Environment.
# Dùng dấu __ cho cấu hình lồng nhau của ASP.NET Core.

ASPNETCORE_ENVIRONMENT=Development

# Supabase Postgres — dùng chuỗi SESSION POOLER (Project Settings > Database)
ConnectionStrings__Default=Host=<pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# Supabase API
Supabase__Url=https://<project-ref>.supabase.co
Supabase__ServiceRoleKey=<service-role-key>   # CHỈ server, tuyệt đối không đưa ra client
Supabase__AudioBucket=audio

# Xác thực JWT admin: điền theo cách project dùng (JWKS hoặc JWT secret)
Supabase__JwtIssuer=https://<project-ref>.supabase.co/auth/v1
Supabase__JwtSecret=<jwt-secret-nếu-dùng-HS256>

# CORS: origin của test client (Vercel)
Cors__AllowedOrigins=http://localhost:5173,https://<ten-app>.vercel.app

# URL web dùng trong QR
PUBLIC_WEB_URL=https://<ten-app>.vercel.app

# Mock payment: success | fail
Payment__MockResult=success

# Seed dữ liệu demo ban đầu (1 khu, 6 POI, 3 ngôn ngữ): true | false
Seed__Enabled=false

# Google Gemini AI (Google AI Studio Free Tier)
Gemini__ApiKey=<your-gemini-api-key>
Gemini__Model=gemini-2.5-flash
